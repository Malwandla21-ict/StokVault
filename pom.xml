<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.stokvault</groupId>
    <artifactId>stokvault</artifactId>
    <version>2.0-SNAPSHOT</version>
    <!-- WAR = Web ARchive: the file format a Jakarta EE server like Payara deploys -->
    <packaging>war</packaging>

    <name>StokVault</name>
    <description>Transparent contribution and payout management for stokvels (Jakarta EE 11)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 21, as specified in the SDD (section 3.3) and required by Payara 7 -->
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <!--
            The whole Jakarta EE 11 platform API: Faces, REST, Security, Enterprise Beans, CDI,
            Persistence, Transactions, Batch, Messaging, Concurrency, Mail, Validation, JSON-B.
            "provided": compile against it, but Payara supplies the implementations at runtime.
        -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>11.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!--
            PostgreSQL JDBC driver. The connection pool (jdbc/StokVaultDS) is created by Payara,
            so the driver is installed into Payara (asadmin add-library), not bundled in the WAR.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- Unit tests (test scope: never part of the WAR) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- target/stokvault.war, served by Payara at /stokvault -->
        <finalName>stokvault</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The branding kit is served as web content (see maven-war-plugin), not put on the classpath -->
                <excludes>
                    <exclude>assets/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Keep method parameter names (useful for JAX-RS and validation messages) -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Runs the JUnit tests during the build; a failing test stops the WAR being built -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!--
                JaCoCo measures test coverage (SDD 10.1 targets >= 80% on business logic).
                After `mvn package`, open target/site/jacoco/index.html.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- Serve the branding kit to browsers at /stokvault/resources/brand/... -->
                    <webResources>
                        <resource>
                            <directory>src/main/resources/assets/branding</directory>
                            <targetPath>resources/brand</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
