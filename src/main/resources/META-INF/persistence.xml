<?xml version="1.0" encoding="UTF-8"?>
<!--
    Jakarta Persistence (JPA) configuration: maps the @Entity classes to PostgreSQL tables.
-->
<persistence version="3.2"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">

    <!-- JTA: transactions are managed by the server (every EJB method runs in one) -->
    <persistence-unit name="StokVaultPU" transaction-type="JTA">

        <!-- The connection pool Payara exposes under this JNDI name (see README, "Payara setup") -->
        <jta-data-source>jdbc/StokVaultDS</jta-data-source>

        <!-- Pick up every @Entity and @Converter in the WAR -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <!--
            Second-level cache (SDD 8.3): only entities marked @Cacheable would be cached. None are,
            so financial records are always read from the database, never from a stale cache.
        -->
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>

        <properties>
            <!--
                On every deploy, create missing tables and add columns for new entity fields; existing
                data is kept. Renamed/retyped fields are NOT migrated: change those with ALTER TABLE.
                (EclipseLink option; the standard jakarta.persistence.schema-generation "create" action
                would ignore new fields on existing tables.)
            -->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>

            <!-- Payara's JPA provider is EclipseLink: generate PostgreSQL SQL -->
            <property name="eclipselink.target-database" value="PostgreSQL"/>

            <!-- Show the SQL in server.log while developing (set to "OFF" in production) -->
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
